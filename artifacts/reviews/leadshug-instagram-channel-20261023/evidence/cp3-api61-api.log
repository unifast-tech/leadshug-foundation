[CHANNEL-LATEST-MESSAGE-EVIDENCE]{"policy_schema_version":"pcv-1","finding_id":"PERF-R3-01","trigger_result":"required","trigger_severity":"high","trigger_reason_code":"PUBLIC-LIST-NESTED-MESSAGE-HYDRATION","gate_deadline":"before_local_implemented","pageLimit":4,"returnedParents":4,"hasLookahead":true,"parentCount":25,"historyRowsPerConversation":500,"totalFixtureMessages":12500,"queryCounts":{"nestedMessageHydration":0,"boundedLatestMessageBatch":1},"measuredSqlShape":"\n        SELECT requested.conversation_id AS \"conversationId\",\n          latest.content,\n          latest.direction::text AS \"direction\",\n          latest.channel_origin::text AS \"channelOrigin\",\n          latest.provider_resource_identity_id AS \"providerResourceIdentityId\"\n        FROM unnest(ARRAY[$?,$?,$?,$?]::text[]) AS requested(conversation_id)\n        LEFT JOIN LATERAL (\n          SELECT candidate.content, candidate.direction, candidate.channel_origin, candidate.provider_resource_identity_id\n          FROM (\n            (\n              SELECT message.id, message.content, message.direction, message.channel_origin, message.provider_resource_identity_id, message.created_at\n              FROM messages AS message\n              WHERE message.conversation_id = requested.conversation_id AND message.direction = 'IN'\n                AND message.channel_origin IN ('OFICIAL'::\"ChannelType\", 'NAO_OFICIAL'::\"ChannelType\")\n                AND (message.provider_resource_identity_id IS NULL OR EXISTS (\n                  SELECT 1 FROM provider_resource_identities AS resource_identity\n                  WHERE resource_identity.id = message.provider_resource_identity_id\n                    AND resource_identity.business_identity_id = $?\n                    AND resource_identity.provider::text = message.channel_origin::text\n                ))\n              ORDER BY message.created_at DESC, message.id DESC\n              LIMIT 1\n            )\n            UNION ALL\n            (\n