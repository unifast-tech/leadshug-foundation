[CP5-EXPLAIN-DIAGNOSTIC]{"source":"BFF-thread-peer-owner-display","capturedSql":"\n      SELECT c.id AS channel_id, cv.id AS conversation_id, r.id AS route_id, cv.contact_type::text AS contact_type,\n        c.type::text AS channel_type, cv.bu_id,\n        c.generation, c.pairing_epoch, c.verified_epoch, c.own_number_verified,\n        c.provider_connection_state, c.receipt_verified_at, rc.route_total AS route_count,\n        b.platform::text AS platform,\n        CASE WHEN b.platform = 'WHATSAPP' AND b.namespace = 'WHATSAPP_RESOURCE' AND b.scope_reference = 'BU'\n          AND pri.id IS NOT NULL AND c.own_number_verified AND c.verified_epoch = c.pairing_epoch\n          AND b.external_resource_id ~ '^\\+?[1-9][0-9]{7,14}$' THEN b.external_resource_id ELSE NULL END AS business_phone,\n        CASE WHEN c.type = 'INSTAGRAM' AND b.namespace = 'INSTAGRAM_LOGIN'\n          AND a.professional_user_id = b.external_resource_id\n          THEN a.username ELSE NULL END AS account_username,\n        b.scope_reference AS business_scope, ci.scope_reference AS contact_scope,\n        b.external_resource_id AS business_resource, pri.id AS provider_identity_id,\n        ci.external_peer_id AS recipient, ci.namespace AS recipient_type, cv.display_name\n      FROM conversations cv\n      LEFT JOIN conversation_routes r ON r.conversation_id = cv.id AND r.bu_id = cv.bu_id AND r.contact_id = cv.contact_id\n      LEFT JOIN LATERAL (\n        SELECT count(*)::int AS route_total FROM conversation_routes rr\n        WHERE rr.conversation_id = cv.id AND rr.bu_id = cv.bu_id AND rr.contact_id = cv.contact_id\n      ) rc ON TRUE\n      LEFT JOIN business_channel_identities b ON b.id = r.business_identity_id AND b.bu_id = r.bu_id\n        AND b.platform = r.platform AND b.scope_reference = r.business_scope_reference\n        AND ((r.platform = 'WHATSAPP' AND b.namespace = 'WHATSAPP_RESOURCE' AND b.scope_reference = 'BU')\n          OR (r.platform = 'INSTAGRAM' AND b.namespace = 'INSTAGRAM_LOGIN'\n            AND r.contact_scope_reference = r.business_scope_reference))\n      LEFT JOIN contact_identities ci ON ci.id = r.contact_identity_id AND ci.bu_id = r.bu_id\n        AND ci.contact_id = r.contact_id AND ci.platform = r.platform AND ci.scope_reference = r.contact_scope_reference\n        AND ((r.platform = 'WHATSAPP' AND ci.namespace = CASE WHEN cv.contact_type = 'PESSOA' THEN 'PERSON' WHEN cv.contact_type = 'GRUPO' THEN 'GROUP' ELSE '' END\n            AND ci.scope_reference = 'BU')\n          OR (r.platform = 'INSTAGRAM' AND ci.namespace = 'INSTAGRAM_LOGIN'\n            AND ci.scope_reference = b.scope_reference AND r.contact_scope_reference = r.business_scope_reference))\n      LEFT JOIN bu_channels c ON c.business_identity_id = b.id AND c.bu_id = b.bu_id\n        AND ((r.platform = 'WHATSAPP' AND c.type IN ('OFICIAL','NAO_OFICIAL')) OR (r.platform = 'INSTAGRAM' AND c.type = 'INSTAGRAM'))\n      LEFT JOIN provider_resource_identities pri ON pri.bu_id = c.bu_id AND pri.current_channel_id = c.id\n        AND pri.business_identity_id = b.id AND pri.provider = c.type\n        AND pri.external_resource_id = CASE\n          WHEN c.type = 'OFICIAL' THEN c.phone_number_id\n          WHEN c.type = 'NAO_OFICIAL' THEN c.evolution_instance_name\n          WHEN c.type = 'INSTAGRAM' THEN b.external_resource_id\n          ELSE NULL END\n        AND pri.retired_at IS NULL\n      LEFT JOIN LATERAL (\n        SELECT ia.username, ia.professional_user_id\n        FROM instagram_authorization_attempts ia\n        WHERE ia.channel_id = c.id AND ia.bu_id = c.bu_id AND ia.professional_user_id = b.external_resource_id\n          AND b.scope_reference = $1 || ':graph.instagram.com:' || b.external_resource_id\n          AND ia.mapped_credential_version IS NOT NULL\n          AND ia.confirmation_state = 'COMPLETED'\n          AND ia.status IN ('MAPPED_PENDING_SUBSCRIPTION', 'MAPPED_PENDING_RECEIPT', 'CANCELLED')\n        ORDER BY ia.mapped_credential_version DESC, ia.id DESC LIMIT 1\n      ) a ON c.type = 'INSTAGRAM'\n      WHERE cv.id IN ($2)\n      GROUP BY cv.id, cv.bu_id, cv.display_name, c.id, c.type, c.generation, c.pairing_epoch,\n        c.verified_epoch, c.own_number_verified, c.provider_connection_state, c.receipt_verified_at,\n        r.id, rc.route_total, cv.contact_type, b.platform, b.namespace, b.scope_reference, b.external_resource_id, pri.id,\n        a.username, a.professional_user_id, ci.external_peer_id, ci.namespace, ci.scope_reference\n    ","capturedParams":["synthetic-instagram-client-id","92d831d6-44f8-46cd-8839-20869e2818c9"],"explainAnalyzeJson":[{"Plan":{"Node Type":"Group","Parallel Aware":false,"Async Capable":false,"Startup Cost":48.51,"Total Cost":48.58,"Plan Rows":1,"Plan Width":852,"Actual Startup Time":0.096,"Actual Total Time":0.098,"Actual Rows":1,"Actual Loops":1,"Group Key":["c.id","r.id","((count(*))::integer)","b.platform","b.namespace","b.scope_reference","b.external_resource_id","pri.id","ia.username","ia.professional_user_id","ci.external_peer_id","ci.namespace","ci.scope_reference"],"Shared Hit Blocks":24,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,"Shared Written Blocks":0,"Local Hit Blocks":0,"Local Read Blocks":0,"Local Dirtied Blocks":0,"Local Written Blocks":0,"Temp Read Blocks":0,"Temp Written Blocks":0,"Plans":[{"Node Type":"Sort","Parent Relationship":"Outer","Parallel Aware":false,"Async Capable":false,"Startup Cost":48.51,"Total Cost":48.52,"Plan Rows":1,"Plan Width":692,"Actual Startup Time":0.093,"Actual Total Time":0.095,"Actual Rows":1,"Actual Loops":1,"Sort Key":["c.id","r.id","((count(*))::integer)","b.platform","b.namespace","b.scope_reference","b.external_resource_id","pri.id","ia.username","ia.professional_user_id","ci.external_peer_id","ci.namespace","ci.scope_reference"],"Sort Method":"quicksort","Sort Space Used":25,"Sort Space Type":"Memory","Shared Hit Blocks":24,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,"Shared Written Blocks":0,"Local Hit Blocks":0,"Local Re