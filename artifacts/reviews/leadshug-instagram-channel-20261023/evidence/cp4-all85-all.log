stdout | test/number-onboarding-pcv.e2e-spec.ts > number onboarding bounded performance and read-scope probes (PostgreSQL) > bounds latest-message hydration for a deep public page and reports the executed SQL plan
[CHANNEL-LATEST-MESSAGE-EVIDENCE]{"policy_schema_version":"pcv-1","finding_id":"PERF-R3-01","trigger_result":"required","trigger_severity":"high","trigger_reason_code":"PUBLIC-LIST-NESTED-MESSAGE-HYDRATION","gate_deadline":"before_local_implemented","pageLimit":4,"returnedParents":4,"hasLookahead":true,"parentCount":25,"historyRowsPerConversation":500,"totalFixtureMessages":12500,"queryCounts":{"nestedMessageHydration":0,"boundedLatestMessageBatch":1},"measuredSqlShape":"\n        SELECT requested.conversation_id AS \"conversationId\",\n          latest.content,\n          latest.direction::text AS \"direction\",\n          latest.channel_origin::text AS \"channelOrigin\",\n          latest.provider_resource_identity_id AS \"providerResourceIdentityId\"\n        FROM unnest(ARRAY[$?,$?,$?,$?]::text[]) AS requested(conversation_id)\n        LEFT JOIN LATERAL (\n          SELECT candidate.content, candidate.direction, candidate.channel_origin, candidate.provider_resource_identity_id\n          FROM (\n            (\n              SELECT message.id, message.content, message.direction, message.channel_origin, message.provider_resource_identity_id, message.created_at\n              FROM messages AS message\n              WHERE message.conversation_id = requested.conversation_id AND message.direction = 'IN'\n                AND message.channel_origin IN ('OFICIAL'::\"ChannelType\", 'NAO_OFICIAL'::\"ChannelType\")\n                AND (message.provider_resource_identity_id IS NULL OR EXISTS (\n                  SELECT 1 FROM provider_resource_identities AS resource_identity\n                  WHERE resource_identity.id = message.provider_resource_identity_id\n                    AND resource_identity.business_identity_id = $?\n                    AND resource_identity.provider::text = message.channel_origin::text\n                ))\n              ORDER BY message.created_at DESC, message.id DESC\n              LIMIT 1\n            )\n            UNION ALL\n            (\n              SELECT message.id, message.content, message.direction, message.channel_origin, message.provider_resource_identity_id, message.created_at\n              FROM messages AS message\n              WHERE message.conversation_id = requested.conversation_id AND message.direction = 'OUT'\n                AND message.channel_origin IN ('OFICIAL'::\"ChannelType\", 'NAO_OFICIAL'::\"ChannelType\")\n                AND (message.provider_resource_identity_id IS NULL OR EXISTS (\n                  SELECT 1 FROM provider_resource_identities AS resource_identity\n                  WHERE resource_identity.id = message.provider_resource_identity_id\n                    AND resource_identity.business_identity_id = $?\n                    AND resource_identity.provider::text = message.channel_origin::text\n                ))\n              ORDER BY message.created_at DESC, message.id DESC\n              LIMIT 1\n            )\n          ) AS candidate\n          ORDER BY candidate.created_at DESC, candidate.id DESC\n          LIMIT 1\n        ) AS latest ON TRUE\n      ","parameterCount":6,"plan":{"Plan":{"Node Type":"Nested Loop","Parallel Aware":false,"Async Capable":false,"Join Type":"Left","Startup Cost":0.83,"Total Cost":51.66,"Plan Rows":4,"Plan Width":151,"Actual Startup Time":0.041,"Actual Total Time":0.081,"Actual Rows":4,"Actual Loops":1,"Inner Unique":false,"Shared Hit Blocks":32,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,"Shared Written Blocks":0,"Local Hit Blocks":0,"Local Read Blocks":0,"Local Dirtied Blocks":0,"Local Written Blocks":0,"Temp Read Blocks":0,"Temp Written Blocks":0,"Plans":[{"Node Type":"Function Scan","Parent Relationship":"Outer","Parallel Aware":false,"Async Capable":false,"Function Name":"unnest","Alias":"requested","Startup Cost":0,"Total Cost":0.04,"Plan Rows":4,"Plan Width":32,"Actual Startup Time":0.005,"Actual Total Time":0.006,"Actual Rows":4,"Actual Loops":1,"Shared Hit Blocks":0,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,