              SELECT message.id, message.content, message.direction, message.channel_origin, message.provider_resource_identity_id, message.created_at\n              FROM messages AS message\n              WHERE message.conversation_id = requested.conversation_id AND message.direction = 'OUT'\n                AND message.channel_origin IN ('OFICIAL'::\"ChannelType\", 'NAO_OFICIAL'::\"ChannelType\")\n                AND (message.provider_resource_identity_id IS NULL OR EXISTS (\n                  SELECT 1 FROM provider_resource_identities AS resource_identity\n                  WHERE resource_identity.id = message.provider_resource_identity_id\n                    AND resource_identity.business_identity_id = $?\n                    AND resource_identity.provider::text = message.channel_origin::text\n                ))\n              ORDER BY message.created_at DESC, message.id DESC\n              LIMIT 1\n            )\n          ) AS candidate\n          ORDER BY candidate.created_at DESC, candidate.id DESC\n          LIMIT 1\n        ) AS latest ON TRUE\n      ","parameterCount":6,"plan":{"Plan":{"Node Type":"Nested Loop","Parallel Aware":false,"Async Capable":false,"Join Type":"Left","Startup Cost":0.83,"Total Cost":51.93,"Plan Rows":4,"Plan Width":151,"Actual Startup Time":0.023,"Actual Total Time":0.057,"Actual Rows":4,"Actual Loops":1,"Inner Unique":false,"Shared Hit Blocks":32,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,"Shared Written Blocks":0,"Local Hit Blocks":0,"Local Read Blocks":0,"Local Dirtied Blocks":0,"Local Written Blocks":0,"Temp Read Blocks":0,"Temp Written Blocks":0,"Plans":[{"Node Type":"Function Scan","Parent Relationship":"Outer","Parallel Aware":false,"Async Capable":false,"Function Name":"unnest","Alias":"requested","Startup Cost":0,"Total Cost":0.04,"Plan Rows":4,"Plan Width":32,"Actual Startup Time":0.002,"Actual Total Time":0.003,"Actual Rows":4,"Actual Loops":1,"Shared Hit Blocks":0,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,