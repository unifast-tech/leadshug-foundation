e, revision, safe_code, remote_template_id, acceptance_provenance, acknowledged_remote_template_id, updated_at,\n          lease_until, recovery_lease_until, mantenedora_id, channel_id, provider_resource_identity_id,\n          account_reference, channel_generation, pairing_epoch, active_credential_version, definition_snapshot\n        FROM message_template_operations\n        WHERE draft_id = $1 AND bu_id = $2 AND mantenedora_id = $3\n        ORDER BY revision DESC LIMIT 11\n      )\n      SELECT op.id AS \"operationId\", op.phase::text AS phase, op.revision, op.safe_code AS \"safeCode\",\n        op.remote_template_id AS \"remoteTemplateId\", op.acceptance_provenance::text AS \"acceptanceProvenance\",\n        op.acknowledged_remote_template_id AS \"acknowledgedRemoteTemplateId\",\n        op.updated_at AS \"updatedAt\", op.lease_until AS \"leaseUntil\", op.recovery_lease_until AS \"recoveryLeaseUntil\",\n        op.mantenedora_id AS \"operationMantenedoraId\", op.channel_id AS \"operationChannelId\",\n        op.provider_resource_identity_id AS \"operationProviderResourceIdentityId\",\n        op.account_reference AS \"operationAccountReference\", op.channel_generation AS \"operationChannelGeneration\",\n        op.pairing_epoch AS \"operationPairingEpoch\", op.active_credential_version AS \"operationActiveCredentialVersion\",\n        op.definition_snapshot AS \"definitionSnapshot\",\n        receipt.id AS \"receiptId\", receipt.sequence AS \"receiptSequence\", receipt.phase::text AS \"receiptPhase\",\n        receipt.safe_code AS \"receiptSafeCode\", receipt.remote_template_id AS \"receiptRemoteTemplateId\",\n        receipt.acceptance_provenance::text AS \"receiptAcceptanceProvenance\", receipt.created_at AS \"receiptCreatedAt\"\n      FROM recent_operations op\n      LEFT JOIN LATERAL (\n        SELECT id, sequence, phase, safe_code, remote_template_id, acceptance_provenance, created_at\n        FROM message_template_submission_receipts\n        WHERE operation_id = op.id\n        ORDER BY sequence DESC LIMIT 10\n      ) receipt ON TRUE\n      ORDER BY op.revision DESC, receipt.sequence DESC"],"receiptQueries":["\n      WITH recent_operations AS (\n        SELECT id, phase, revision, safe_code, remote_template_id, acceptance_provenance, acknowledged_remote_template_id, updated_at,\n          lease_until, recovery_lease_until, mantenedora_id, channel_id, provider_resource_identity_id,\n          account_reference, channel_generation, pairing_epoch, active_credential_version, definition_snapshot\n        FROM message_template_operations\n        WHERE draft_id = $1 AND bu_id = $2 AND mantenedora_id = $3\n        ORDER BY revision DESC LIMIT 11\n      )\n      SELECT op.id AS \"operationId\", op.phase::text AS phase, op.revision, op.safe_code AS \"safeCode\",\n        op.remote_template_id AS \"remoteTemplateId\", op.acceptance_provenance::text AS \"acceptanceProvenance\",\n        op.acknowledged_remote_template_id AS \"acknowledgedRemoteTemplateId\",\n        op.updated_at AS \"updatedAt\", op.lease_until AS \"leaseUntil\", op.recovery_lease_until AS \"recoveryLeaseUntil\",\n        op.mantenedora_id AS \"operationMantenedoraId\", op.channel_id AS \"operationChannelId\",\n        op.provider_resource_identity_id AS \"operationProviderResourceIdentityId\",\n        op.account_reference AS \"operationAccountReference\", op.channel_generation AS \"operationChannelGeneration\",\n        op.pairing_epoch AS \"operationPairingEpoch\", op.active_credential_version AS \"operationActiveCredentialVersion\",\n        op.definition_snapshot AS \"definitionSnapshot\",\n        receipt.id AS \"receiptId\", receipt.sequence AS \"receiptSequence\", receipt.phase::text AS \"receiptPhase\",\n        receipt.safe_code AS \"receiptSafeCode\", receipt.remote_template_id AS \"receiptRemoteTemplateId\",\n        receipt.acceptance_provenance::text AS \"receiptAcceptanceProvenance\", receipt.created_at AS \"receiptCreatedAt\"\n      FROM recent_operations op\n      LEFT JOIN LATERAL (\n        SELECT id, sequence, phase, safe_code, remote_template_id, acceptance_provenance, created_at\n        FROM message_template_submission_receipts\n        WHERE operation_id = op.id\n        ORDER BY sequence DESC LIMIT 10\n      ) receipt ON TRUE\n      ORDER BY op.revision DESC, receipt.sequence DESC"],"queryPlan":[{"Plan":{"Node Type":"Incremental Sort","Parallel Aware":false,"Async Capable":false,"Startup Cost":27.32,"Total Cost":296.52,"Plan Rows":110,"Plan Width":785,"Actual Startup Time":0.293,"Actual Total Time":0.457,"Actual Rows":110,"Actual Loops":1,"Sort Key":["message_template_operations.revision DESC","message_template_submission_receipts.sequence DESC"],"Presorted Key":["message_template_operations.revision"],"Full-sort Groups":{"Group Count":3,"Sort Methods Used":["quicksort"],"Sort Space Memory":{"Average Sort Space Used":47,"Peak Sort Space Used":47}},"Shared Hit Blocks":40,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,"Shared Written Blocks":0,"Local Hit Blocks":0,"Local Read Blocks":0,"Local Dirtied Blocks":0,"Local Written Blocks":0,"Temp Read Blocks":0,"Temp Written Blocks":0,"Plans":[{"Node Type":"Nested Loop","Parent Relationship":"Outer","Parallel Aware":false,"Async Capable":false,"Join Type":"Left","Startup Cost":0.56,"Total Cost":293.1,"Plan Rows":110,"Plan Width":785,"Actual Startup Time":0.046,"Actual Total Time":0.299,"Actual Rows":110,"Actual Loops":1,"Inner Unique":false,"Shared Hit Blocks":40,"Shared Read Blocks":0,"Shared Dirtied Blocks":0,"Shared Written Blocks":0,"Local Hit Blocks":0,"Local Read Blocks":0,"Local Dirtied Blocks":0,"Local Written Blocks":0,"Temp Read Blocks":0,"Temp Written Blocks":0,"Plans":[{"Node Type":"Limit","Parent Relationship":"Outer","Parallel Aware":false,"Async Capable":false,"Startup Cost":0.28,"Total Cost":23.48,"Plan Rows":11,"Plan Width":589,"Actual Startup Time":0.024,"Actual Total Time":0.032,"Actual Rows":11,"Actual Loops":1,"Shared Hit Blocks":4