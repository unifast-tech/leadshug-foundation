[CHANNEL-LATEST-MESSAGE-EVIDENCE]{"policy_schema_version":"pcv-1","finding_id":"PERF-R3-01","trigger_result":"required","trigger_severity":"high","trigger_reason_code":"PUBLIC-LIST-NESTED-MESSAGE-HYDRATION","gate_deadline":"before_local_implemented","pageLimit":4,"returnedParents":4,"hasLookahead":true,"parentCount":25,"historyRowsPerConversation":500,"totalFixtureMessages":12500,"queryCounts":{"nestedMessageHydration":0,"boundedLatestMessageBatch":1},"measuredSqlShape":"\n        SELECT requested.conversation_id AS \"conversationId\",\n          latest.content,\n          latest.direction::text AS \"direction\",\n          latest.channel_origin::text AS \"channelOrigin\"\n        FROM unnest(ARRAY[$?,$?,$?,$?]::text[]) AS requested(conversation_id)\n        LEFT JOIN LATERAL (\n          SELECT candidate.content, candidate.direction, candidate.channel_origin\n          FROM (\n            (\n              SELECT message.id, message.content, message.direction, message.channel_origin, message.created_at\n              FROM messages AS message\n              WHERE message.conversation_id = requested.conversation_id AND message.direction = 'IN'\n              ORDER BY message.created_at DESC, message.id DESC\n              LIMIT 1\n            )\n            UNION ALL\n            (\n              SELECT message.id, message.content, message.direction, message.channel_origin, message.created_at\n              FROM messages AS message\n              WHERE message.conversation_id = requested.conversation_id AND message.direction = 'OUT'\n              ORDER BY message.created_at DESC, message.id DESC\n              LIMIT 1\n            )\n          ) AS candidate\n          ORDER BY candidate.created_at DESC, candidate.id DESC\n          LIMIT 1\n        ) AS latest ON TRUE\n      ","parameterCount":4,"plan":{"Plan":{"Node Type":"Nested Loop","Parallel Aware":false,"Async Capable":false,"Join Type":"Left","Startup Cost":0.83,"Total Cost":17.44,"Plan Rows":4,"Plan Width":1